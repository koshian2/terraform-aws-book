terraform {
  required_version = ">= 1.11, < 2.0"
  required_providers {
    aws = { source = "hashicorp/aws", version = "= 6.66.0" }
  }
  backend "local" { path = "terraform.tfstate" }
}

variable "aws_profile" {
  type    = string
  default = "develop"
}
variable "aws_region" {
  type    = string
  default = "ap-northeast-1"
}

provider "aws" {
  profile = var.aws_profile
  region  = var.aws_region
  default_tags {
    tags = { Project = "agentcore-code-interpreter-shift", ManagedBy = "Terraform" }
  }
}

# 外部通信を閉じた環境で生成コードを実行する。
# 実行ロールを付与せず、AWSリソースへの権限を与えない。
resource "aws_bedrockagentcore_code_interpreter" "main" {
  name        = "mcp_code_interpreter"
  description = "Sandbox for code generated by a local coding agent"
  network_configuration { network_mode = "SANDBOX" }
}

output "client_config" {
  value = {
    aws_profile         = var.aws_profile
    aws_region          = var.aws_region
    code_interpreter_id = aws_bedrockagentcore_code_interpreter.main.code_interpreter_id
  }
}
