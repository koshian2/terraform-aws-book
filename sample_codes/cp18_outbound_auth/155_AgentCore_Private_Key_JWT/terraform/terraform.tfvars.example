tenant_id = "YOUR_TENANT_GUID"
# entra-graph-pkjwt-api のアプリケーション（クライアント）ID
api_client_id = "YOUR_OBO_API_CLIENT_GUID"
# entra-graph-pkjwt-m2m のアプリケーション（クライアント）ID
m2m_client_id = "YOUR_M2M_CLIENT_GUID"
# ログイン用アプリのID。前のOBOサンプルの entra-graph-obo-client を再利用可能。
# 手順は ../entra-setup.md の「既存の公開クライアントを再利用する場合」を参照。
local_client_id = "YOUR_PUBLIC_CLIENT_GUID"
enable_obo = true
# key_arns / certificate_thumbprints are generated by scripts/configure_certificates.py.
