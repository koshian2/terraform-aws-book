terraform {
  required_version = ">= 1.11, < 2.0"
  required_providers {
    aws = { source = "hashicorp/aws", version = "= 6.66.0" }
  }
  backend "local" { path = "terraform.tfstate" }
}
provider "aws" {
  profile = var.aws_profile
  region  = var.aws_region
  default_tags { tags = { Project = "agentcore-github-consent-portal", ManagedBy = "Terraform" } }
}
variable "aws_profile" {
  type    = string
  default = "develop"
}
variable "aws_region" {
  type    = string
  default = "ap-northeast-1"
}
variable "name" {
  type    = string
  default = "github-consent-demo"
  validation {
    condition     = can(regex("^[a-z][a-z0-9-]{0,24}$", var.name))
    error_message = "Use a lowercase name of at most 25 characters."
  }
}

variable "github_repository" {
  type = string

  validation {
    condition     = can(regex("^[A-Za-z0-9][A-Za-z0-9-]*/[A-Za-z0-9_.-]+$", var.github_repository))
    error_message = "Use owner/repository."
  }
}
variable "github_client_id" {
  type    = string
  default = "pending-registration"
}
variable "github_client_secret" {
  type      = string
  sensitive = true
  ephemeral = true
  default   = "pending-registration"
}
variable "github_credentials_version" {
  type    = number
  default = 1
}
variable "portal_client_id" {
  description = "Public ID generated by the portal stack; finalize.py sets this after the first apply."
  type        = string
  default     = null
  nullable    = true
}
variable "codex_oauth_callback_url" {
  type     = string
  default  = null
  nullable = true
  validation {
    condition     = var.codex_oauth_callback_url == null ? true : can(regex("^http://(localhost|127[.]0[.]0[.]1):8766/callback/[A-Za-z0-9_-]+$", var.codex_oauth_callback_url))
    error_message = "Use the complete Codex localhost callback URL."
  }
}
data "aws_caller_identity" "current" {}
locals {
  prefix                  = "arn:aws:bedrock-agentcore:${var.aws_region}:${data.aws_caller_identity.current.account_id}"
  issuer                  = "https://cognito-idp.${var.aws_region}.amazonaws.com/${aws_cognito_user_pool.users.id}"
  login_base              = "https://${aws_cognito_user_pool_domain.login.domain}.auth.${var.aws_region}.amazoncognito.com"
  invoke_scope            = "github-mcp/invoke"
  portal_url              = aws_cloudformation_stack.portal.outputs["PortalUrl"]
  provider_prefix         = "${local.prefix}:token-vault/default/oauth2credentialprovider/${var.name}-*"
  managed_provider_prefix = "${local.prefix}:token-vault/default/oauth2credentialprovider/${var.name}-*-oidc"
  workload_resources      = ["${local.prefix}:workload-identity-directory/default", "${local.prefix}:workload-identity-directory/default/workload-identity/${var.name}-*"]
}

resource "aws_cognito_user_pool" "users" {
  name = "${var.name}-users"
  admin_create_user_config { allow_admin_create_user_only = true }
  password_policy {
    minimum_length    = 12
    require_lowercase = true
    require_uppercase = true
    require_numbers   = true
    require_symbols   = true
  }
}
resource "aws_cognito_user_pool_domain" "login" {
  domain                = "mcp-${lower(replace(aws_cognito_user_pool.users.id, "_", "-"))}"
  user_pool_id          = aws_cognito_user_pool.users.id
  managed_login_version = 1
}
resource "aws_cognito_resource_server" "mcp" {
  identifier   = "github-mcp"
  name         = "GitHub Issue MCP"
  user_pool_id = aws_cognito_user_pool.users.id
  scope {
    scope_name        = "invoke"
    scope_description = "Read GitHub issues through the gateway"
  }
}
resource "aws_cognito_user_pool_client" "local" {
  name                                 = "${var.name}-local"
  user_pool_id                         = aws_cognito_user_pool.users.id
  generate_secret                      = false
  allowed_oauth_flows_user_pool_client = true
  allowed_oauth_flows                  = ["code"]
  allowed_oauth_scopes                 = ["openid", local.invoke_scope]
  callback_urls                        = concat(["http://localhost:8765/callback", "http://localhost:8767/callback"], var.codex_oauth_callback_url == null ? [] : [var.codex_oauth_callback_url])
  default_redirect_uri                 = "http://localhost:8765/callback"
  logout_urls                          = ["http://localhost:8768/signed-out"]
  supported_identity_providers         = ["COGNITO"]
  explicit_auth_flows                  = ["ALLOW_REFRESH_TOKEN_AUTH"]
  prevent_user_existence_errors        = "ENABLED"
  enable_token_revocation              = true
  access_token_validity                = 60
  id_token_validity                    = 60
  refresh_token_validity               = 1
  token_validity_units {
    access_token  = "minutes"
    id_token      = "minutes"
    refresh_token = "days"
  }
  depends_on = [aws_cognito_resource_server.mcp]
}
resource "aws_bedrockagentcore_oauth2_credential_provider" "github" {
  name                       = "${var.name}-github"
  credential_provider_vendor = "GithubOauth2"
  oauth2_provider_config {
    github_oauth2_provider_config {
      client_id_wo                  = var.github_client_id
      client_secret_wo              = var.github_client_secret
      client_credentials_wo_version = var.github_credentials_version
    }
  }
}

resource "aws_iam_role" "gateway" {
  name = "${var.name}-gateway"
  assume_role_policy = jsonencode({ Version = "2012-10-17", Statement = [{
    Effect    = "Allow", Principal = { Service = "bedrock-agentcore.amazonaws.com" }, Action = "sts:AssumeRole",
    Condition = { StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id }, ArnLike = { "aws:SourceArn" = "${local.prefix}:gateway/${var.name}-*" } }
  }] })
}
resource "aws_iam_role_policy" "gateway" {
  role = aws_iam_role.gateway.id
  policy = jsonencode({ Version = "2012-10-17", Statement = [
    { Effect = "Allow", Action = ["bedrock-agentcore:GetWorkloadAccessToken", "bedrock-agentcore:GetWorkloadAccessTokenForJWT"], Resource = local.workload_resources },
    { Effect = "Allow", Action = ["bedrock-agentcore:GetResourceOauth2Token"], Resource = concat([aws_bedrockagentcore_oauth2_credential_provider.github.credential_provider_arn, "${local.prefix}:token-vault/default"], local.workload_resources) },
    { Effect = "Allow", Action = ["secretsmanager:GetSecretValue"], Resource = aws_bedrockagentcore_oauth2_credential_provider.github.client_secret_arn[0].secret_arn }
  ] })
}
resource "aws_bedrockagentcore_gateway" "github" {
  name            = var.name
  role_arn        = aws_iam_role.gateway.arn
  authorizer_type = "CUSTOM_JWT"
  protocol_type   = "MCP"
  protocol_configuration {
    mcp {
      supported_versions = ["2025-11-25"]
    }
  }
  authorizer_configuration {
    custom_jwt_authorizer {
      discovery_url   = "${local.issuer}/.well-known/openid-configuration"
      allowed_clients = concat([aws_cognito_user_pool_client.local.id], var.portal_client_id == null ? [] : [var.portal_client_id])
      allowed_scopes  = [local.invoke_scope]
    }
  }
  depends_on = [aws_iam_role_policy.gateway]
}
resource "aws_bedrockagentcore_gateway_target" "github" {
  name               = "github-issues"
  gateway_identifier = aws_bedrockagentcore_gateway.github.gateway_id
  credential_provider_configuration {
    oauth {
      provider_arn       = aws_bedrockagentcore_oauth2_credential_provider.github.credential_provider_arn
      grant_type         = "AUTHORIZATION_CODE"
      scopes             = [] # GitHub App permissions are configured on the App.
      default_return_url = "${local.portal_url}/connect/callback"
    }
  }
  target_configuration {
    mcp {
      open_api_schema {
        inline_payload {
          payload = templatefile("${path.module}/github.openapi.json.tftpl", { repository = var.github_repository })
        }
      }
    }
  }
}
